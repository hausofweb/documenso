{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix=../..",
  "buildCommand": "cd ../.. && npx turbo run build --filter=@documenso/remix... && npx prisma migrate deploy --schema packages/prisma/schema.prisma",
  "outputDirectory": "build/client",
  "regions": ["iad1"],
  "functions": {
    "api/server.js": {
      "maxDuration": 300,
      "includeFiles": "{build/server/**,public/fonts/**,public/static/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/server" }]
}
